---
layout: null
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  
  {% for page in site.pages %}
    {% if page.url contains '.xml' or page.url contains 'assets' or page.url contains '404' or page.url contains 'css' %}
    {% else %}
    <url>
      <loc>{{ site.url | default: "https://www.divemedya.com" }}{{ page.url | remove: "index.html" }}</loc>
      <changefreq>weekly</changefreq>
      <priority>0.8</priority>
    </url>
    {% endif %}
  {% endfor %}

  {% for post in site.posts %}
    <url>
      <loc>{{ site.url | default: "https://www.divemedya.com" }}{{ post.url }}</loc>
      <lastmod>{{ post.date | date_to_xmlschema }}</lastmod>
      <changefreq>monthly</changefreq>
      <priority>0.6</priority>
    </url>
  {% endfor %}

</urlset>
